# Telegram BotFather dan olingan bot tokeni
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin kirish ma'lumotlari (Botga kirishda so'raladi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kuzatiladigan servislar (systemd servis yoki jarayon nomi, vergul bilan)
MONITORED_SERVICES=nginx,docker,postgresql,mysql,redis,ssh

# Monitoring tekshirish oralig'i (soniyalarda)
CHECK_INTERVAL=15

# Resurslar chegarasi (ogohlantirish berish uchun foiz ko'rsatkichi)
CPU_THRESHOLD=85.0
RAM_THRESHOLD=90.0
DISK_THRESHOLD=90.0

# Kuzatiladigan log fayllar (vergul bilan ajratilgan)
# Ilova loglari yoki tizim log fayllari: logs/server_activity.log, /var/log/secure, /var/log/syslog
WATCH_LOG_FILES=logs/server_activity.log,logs/server_errors.log

# Kuzatiladigan log va server harakatlari kategoriyalari:
# security  - SSH kirishlar, muvaffaqiyatsiz urinishlar, sudo va root amallari
# service   - Servislar ishga tushishi, to'xtashi, qayta yuklanishi (Started, Stopped)
# error     - Tizim va dastur xatoliklari (ERROR, CRITICAL, EXCEPTION, TRACEBACK)
# warning   - Ogohlantirishlar (WARN, WARNING, Access denied, Connection refused)
# system    - Tizim o'chishi, qayta yuklanishi, OOM Killer (jarayon majburiy o'ldirilishi)
# action    - Muhim operatsiyalar (Deploy, Backup, Cron, Paket o'rnatish)
WATCH_LOG_CATEGORIES=security,service,error,warning,system,action

# Qo'shimcha o'zingizga kerakli maxsus kalit so'zlar (ixtiyoriy, vergul bilan)
CUSTOM_LOG_KEYWORDS=deploy,backup,restart,database,fail

# Tizim hodisalarini (SSH, sudo, systemd) to'g'ridan-to'g'ri journalctl dan kuzatish (true/false)
ENABLE_JOURNALCTL=true

# Bir xil xabarlar ketma-ket kelsa, spam bo'lmasligi uchun cheklov vaqti (soniya)
LOG_THROTTLE_SECONDS=60

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent
